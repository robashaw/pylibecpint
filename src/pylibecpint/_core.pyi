import numpy as np
import numpy.typing as npt

MAX_L: int
__libecpint_version__: str

class GaussianECP:
    n: int
    l: int
    a: float
    d: float
    def __init__(self, n: int = ..., l: int = ..., a: float = ..., d: float = ...) -> None: ...

class ECP:
    N: int
    L: int
    def __init__(self, center: npt.NDArray[np.float64] | None = ...) -> None: ...
    def addPrimitive(
        self, n: int, l: int, a: float, d: float, needSort: bool = True
    ) -> None: ...
    def center(self) -> npt.NDArray[np.float64]: ...
    def setPos(self, x: float, y: float, z: float) -> None: ...
    def sort(self) -> None: ...
    def getGaussian(self, i: int) -> GaussianECP: ...
    def getN(self) -> int: ...
    def noType1(self) -> bool: ...
    def evaluate(self, r: float, l: int) -> float: ...
    def getL(self) -> int: ...

class ECPBasis:
    core_electrons: dict[int, int]
    def __init__(self) -> None: ...
    def addECP(self, U: ECP, atom: int) -> None: ...
    def getECP(self, i: int) -> ECP: ...
    def getECPCore(self, q: int) -> int: ...
    def getAtom(self, i: int) -> int: ...
    def getMaxL(self) -> int: ...
    def getN(self) -> int: ...
    def addECP_from_file(
        self, q: int, coords: npt.NDArray[np.float64], filename: str
    ) -> None: ...

class GaussianShell:
    def __init__(self, center: npt.NDArray[np.float64], l: int) -> None: ...
    def addPrim(self, exp: float, c: float) -> None: ...
    def nprimitive(self) -> int: ...
    def ncartesian(self) -> int: ...
    def center(self) -> npt.NDArray[np.float64]: ...
    def exp(self, i: int) -> float: ...
    def coef(self, i: int) -> float: ...
    def am(self) -> int: ...

class ShellPairData:
    LA: int
    LB: int
    maxLBasis: int
    ncartA: int
    ncartB: int
    A: npt.NDArray[np.float64]
    B: npt.NDArray[np.float64]
    A2: float
    Am: float
    B2: float
    Bm: float
    RAB2: float
    RABm: float
    A_on_ecp: bool
    B_on_ecp: bool

class TwoIndex:
    def __init__(self, dim1: int = ..., dim2: int = ..., value: float = ...) -> None: ...
    def __getitem__(self, idx: tuple[int, int]) -> float: ...
    def __setitem__(self, idx: tuple[int, int], val: float) -> None: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    def to_numpy(self) -> npt.NDArray[np.float64]: ...

class ECPIntegral:
    skipped: int
    zero: int
    nonzero: int
    def __init__(
        self,
        maxLB: int,
        maxLU: int,
        deriv: int = 0,
        thresh: float = 1e-15,
    ) -> None: ...
    def compute_shell_pair(
        self,
        U: ECP,
        shellA: GaussianShell,
        shellB: GaussianShell,
        shiftA: int = 0,
        shiftB: int = 0,
    ) -> TwoIndex: ...
    def compute_shell_pair_derivative(
        self, U: ECP, shellA: GaussianShell, shellB: GaussianShell
    ) -> list[TwoIndex]: ...
    def compute_shell_pair_second_derivative(
        self, U: ECP, shellA: GaussianShell, shellB: GaussianShell
    ) -> list[TwoIndex]: ...
    def compute_shell_pair_derivative_Bfield(
        self, U: ECP, shellA: GaussianShell, shellB: GaussianShell
    ) -> list[TwoIndex]: ...

class ECPIntegrator:
    tolerance: float
    @property
    def ncart(self) -> int: ...
    @property
    def natoms(self) -> int: ...
    @property
    def maxLB(self) -> int: ...
    @property
    def deriv(self) -> int: ...
    def __init__(self) -> None: ...
    def set_gaussian_basis(
        self,
        coords: npt.NDArray[np.float64],
        exponents: npt.NDArray[np.float64],
        coefs: npt.NDArray[np.float64],
        ams: npt.NDArray[np.int32],
        shell_lengths: npt.NDArray[np.int32],
    ) -> None: ...
    def set_ecp_basis(
        self,
        coords: npt.NDArray[np.float64],
        exponents: npt.NDArray[np.float64],
        coefs: npt.NDArray[np.float64],
        ams: npt.NDArray[np.int32],
        ns: npt.NDArray[np.int32],
        shell_lengths: npt.NDArray[np.int32],
    ) -> None: ...
    def set_ecp_basis_from_library(
        self,
        coords: npt.NDArray[np.float64],
        charges: npt.NDArray[np.int32],
        names: list[str],
        share_dir: str,
    ) -> None: ...
    def update_gaussian_basis_coords(
        self, coords: npt.NDArray[np.float64]
    ) -> None: ...
    def update_ecp_basis_coords(
        self, coords: npt.NDArray[np.float64]
    ) -> None: ...
    def init(
        self,
        deriv: int = 0,
        tol: float = 1e-12,
        radial_tol: float = 1e-15,
    ) -> None: ...
    def compute_integrals(self) -> None: ...
    def compute_first_derivs(self) -> None: ...
    def compute_second_derivs(self) -> None: ...
    def compute_bfield_derivs(self) -> None: ...
    def compute_gradient(
        self, density: npt.NDArray[np.float64]
    ) -> npt.NDArray[np.float64]: ...
    def compute_hessian(
        self, density: npt.NDArray[np.float64]
    ) -> npt.NDArray[np.float64]: ...
    def get_integrals(self) -> npt.NDArray[np.float64]: ...
    def get_first_derivs(self) -> list[npt.NDArray[np.float64]]: ...
    def get_second_derivs(self) -> list[npt.NDArray[np.float64]]: ...
    def get_bfield_derivs(self) -> list[npt.NDArray[np.float64]]: ...
